Name     KAYPRO_SRAM_CTRL;
PartNo   01;
Date     10/21/2026;
Revision 24;
Designer WAC;
Company  Custom;
Assembly None;
Location None;
Device   f1504ispplcc44;

/*******************************************************************************/
/* Copyright (C) 2026 WAC-KP                                                   */
