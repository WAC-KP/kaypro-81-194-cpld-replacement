  9:Device   f1504ispplcc44;
 10:
 11:/*********************************************************
 12: * INPUTS - LOCKED TO PCB
 13: *********************************************************/
 14:PIN 43 = CLK16;
 15:PIN 33 = MREQ_N;
 16:PIN 36 = WR_N;
 17:PIN 29 = BANK;
 18:PIN 25 = A15;
 19:PIN 34 = RD_N;
 20:PIN 31 = RESET_N;
 21:
 22:/* JTAG */
 23:PIN 7  = TDI;
 24:PIN 13 = TMS;
 25:PIN 32 = TCK;
 26:PIN 38 = TDO;
 27:
 28:/*********************************************************
 29: * OUTPUTS & PROPERTIES
 30: *********************************************************/
 31:PIN 8  = CLK4;
 32:PIN 6  = CLK2;
 33:PIN 5  = CLK1;
 34:PIN 4  = CLK4K8;
 35:PIN 24 = ROM_EN_N;
 36:PIN 26 = RAM_EN_N;
 37:PIN 40 = SRAM_A16;
 38:PIN 27 = SRAM_WE_N;
 39:PIN 28 = SRAM_OE_N;
 40:PIN 9  = HEARTBEAT_LED;
 41:
 42:/* Global hardware-hardening optimizations for the ATF1504 */
 43:PROPERTY ATMEL {power = low};          /* Drops internal junction heat and thermal drift */
 44:
 45:/* Keep clocks slow to prevent vintage motherboard ringing */
 46:PROPERTY ATMEL {slew = CLK4 = slow};
 47:PROPERTY ATMEL {slew = CLK2 = slow};
 48:PROPERTY ATMEL {slew = CLK1 = slow};
 49:
 50:/* NOTE: ROM_EN_N and RAM_EN_N run at FAST slew rate by omitting the 'slow' */
 51:/* property. This maximizes the data hold window when the system is hot. */
 52:
 53:/*********************************************************

