 54: * INTERNAL REGISTERS
 55: *********************************************************/
 56:NODE [DIV0..3], [CNT0..11], [LEDCNT0..9];
 57:
 58:[DIV0..3].ck    = CLK16;
 59:[CNT0..11].ck   = CLK16;
 60:[LEDCNT0..9].ck = CLK4K8;
 61:
 62:/* Clock Generation */
 63:DIV0.d = !DIV0;
 64:DIV1.d = DIV1 $ DIV0;
 65:DIV2.d = DIV2 $ (DIV1 & DIV0);
 66:DIV3.d = DIV3 $ (DIV2 & DIV1 & DIV0);
 67:
 68:CLK4 = DIV1;
 69:CLK2 = DIV2;
 70:CLK1 = DIV3;
 71:
 72:/* 4.8 kHz Keyboard Clock Divider (3334 states: 0 to 3333) */
 73:RST_C = (CNT11 & CNT10 & CNT8 & CNT2 & CNT0); 
 74:CNT0.d  = !CNT0  & !RST_C;
 75:CNT1.d  = (CNT1  $ CNT0) & !RST_C;
 76:CNT2.d  = (CNT2  $ (CNT1  & CNT0)) & !RST_C;
 77:CNT3.d  = (CNT3  $ (CNT2  & CNT1  & CNT0)) & !RST_C;
 78:CNT4.d  = (CNT4  $ (CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 79:CNT5.d  = (CNT5  $ (CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 80:CNT6.d  = (CNT6  $ (CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 81:CNT7.d  = (CNT7  $ (CNT6  & CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 82:CNT8.d  = (CNT8  $ (CNT7  & CNT6  & CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 83:CNT9.d  = (CNT9  $ (CNT8  & CNT7  & CNT6  & CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 84:CNT10.d = (CNT10 $ (CNT9  & CNT8  & CNT7  & CNT6  & CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 85:CNT11.d = (CNT11 $ (CNT10 & CNT9  & CNT8  & CNT7  & CNT6  & CNT5  & CNT4  & CNT3  & CNT2  & CNT1  & CNT0)) & !RST_C;
 86:
 87:CLK4K8 = CNT11;
 88:
 89:/* LED Heartbeat */
 90:LEDCNT0.d = !LEDCNT0;
 91:LEDCNT1.d = LEDCNT1 $ LEDCNT0;
 92:LEDCNT2.d = LEDCNT2 $ (LEDCNT1 & LEDCNT0);
 93:LEDCNT3.d = LEDCNT3 $ (LEDCNT2 & LEDCNT1 & LEDCNT0);
 94:LEDCNT4.d = LEDCNT4 $ (LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
 95:LEDCNT5.d = LEDCNT5 $ (LEDCNT4 & LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
 96:LEDCNT6.d = LEDCNT6 $ (LEDCNT5 & LEDCNT4 & LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
 97:LEDCNT7.d = LEDCNT7 $ (LEDCNT6 & LEDCNT5 & LEDCNT4 & LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
 98:LEDCNT8.d = LEDCNT8 $ (LEDCNT7 & LEDCNT6 & LEDCNT5 & LEDCNT4 & LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
 99:LEDCNT9.d = LEDCNT9 $ (LEDCNT8 & LEDCNT7 & LEDCNT6 & LEDCNT5 & LEDCNT4 & LEDCNT3 & LEDCNT2 & LEDCNT1 & LEDCNT0);
100:
101:HEARTBEAT_LED = !LEDCNT9;
102:
103:/* ========================================================= */
104:/* GLITCH-PROOF BUS-ISOLATED UNIVERSAL MEMORY SELECT         */
105:/* ========================================================= */
106:
107:/* ROM Enable: Low when MREQ is low, WR is high, BANK pullup is high (1), and A15 is low */

LISTING FOR LOGIC DESCRIPTION FILE: KAYPRO_SRAM_CTRL-6.pld           Page 3

CUPL(WM): Universal Compiler for Programmable Logic
Version 5.0a Serial# MW-10400000
Copyright (c) 1983, 1998 Logical Devices, Inc.
Created Wed Oct 21 08:13:30 2026

108:ROM_EN_N  = !(!MREQ_N & WR_N & BANK & !A15);
109:
110:/* RAM Enable: Low when MREQ is low AND either BANK is low (0) OR A15 is high (1) */
111:RAM_EN_N  = !(!MREQ_N & (!BANK # A15));
112:
113:/* ========================================================= */
114:/* HARDWARE BUS-ISOLATION INTERLOCKS                         */
115:/* ========================================================= */
116:
117:/* SRAM Write Control: Only allow writing when RAM is explicitly enabled, */
118:/* WR_N is low, and the ROM is completely disabled. Forces high on reset. */
119:SRAM_WE_N = WR_N # RAM_EN_N # !ROM_EN_N # !RESET_N;
120:
121:/* SRAM Read Control: Forcefully lock the SRAM's output buffers into a      */
122:/* high-impedance (tri-state) mode if the Monitor ROM is currently active.   */
123:SRAM_OE_N = RD_N # RAM_EN_N # !ROM_EN_N;
124:
125:SRAM_A16  = 'b'0;
126:
127:END;
128:
129:



